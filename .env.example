# ---------------------------------------------------------------------------
# NexusBot configuration. Copy to `.env` and edit. Every key maps 1:1 to
# `app/config.py::Settings`. Values shown are the defaults unless marked required.
# ---------------------------------------------------------------------------

# ---- App ----
APP_NAME=NexusBot
# development | staging | production | test
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated list, or * for any origin (credentials are then disabled).
ALLOWED_ORIGINS=*

# ---- Security ----
# REQUIRED in production: at least 32 random characters.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=15

# ---- Database (required) ----
# Inside docker compose the host is `postgres`; locally use 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@postgres:5432/chatbot
SYNC_DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AI providers ----
# Every provider with credentials configured is enabled and its models show up in
# GET /models. At least one is required unless AI_FAKE_MODE=true.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model (text-embedding-3-small = 1536).
OPENAI_EMBEDDING_DIM=1536
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Which Azure deployment serves each model id, e.g. {"gpt-4o-mini": "my-deployment"}
AZURE_OPENAI_DEPLOYMENTS=
OLLAMA_BASE_URL=
# Comma separated local models, e.g. llama3.1:8b,qwen2.5:14b
OLLAMA_MODELS=
# Server default model (falls back to OPENAI_CHAT_MODEL, then the first available).
DEFAULT_CHAT_MODEL=
# Optional JSON/YAML catalog with extra or overriding model specs.
MODEL_CATALOG_PATH=
# Comma separated allow/deny lists of model ids exposed to clients.
ENABLED_MODELS=
DISABLED_MODELS=
# Tried in order when the primary provider fails before any token was streamed,
# e.g. {"gpt-4o": ["claude-sonnet-5-5"]}
MODEL_FALLBACKS=
# Run everything with a deterministic in-process model and embeddings (no API key).
AI_FAKE_MODE=false
EMBEDDING_BATCH_SIZE=64
# Per-1K-token USD prices merged over the built-in table, e.g.
# MODEL_PRICING={"gpt-4o-mini": [0.00015, 0.0006]}
MODEL_PRICING=
GENERATION_TIMEOUT_SECONDS=180

# ---- LangSmith tracing (optional) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexusbot

# ---- RAG ----
VECTOR_BACKEND=pgvector
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20
# Hybrid retrieval: pgvector + Postgres full-text fused with reciprocal rank fusion.
RAG_HYBRID_SEARCH=true
RAG_CANDIDATES_MULTIPLIER=4
# none | llm (asks the chat model to grade candidates; one extra call per turn)
RAG_RERANKER=none
# Rewrite follow-up questions into standalone queries using the conversation.
RAG_QUERY_REWRITE=false
# Prepend "document > section" headers to chunks before embedding.
RAG_CONTEXT_HEADERS=true

# ---- Agent ----
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_SECONDS=60
# Extra tools that must be approved by the user before they run (fetch_url always is).
TOOLS_REQUIRING_APPROVAL=
APPROVAL_TTL_MINUTES=30

# ---- Outbound web fetching (URL ingestion, fetch_url tool) ----
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_TIMEOUT_SECONDS=20
# Never enable in production: allows fetches of private/loopback addresses (tests only).
WEB_FETCH_ALLOW_PRIVATE=false
HTTP_TRUST_ENV=true

# ---- Chat / memory ----
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_SUMMARY_TRIGGER_TOKENS=3000
CHAT_RESPONSE_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.4
# Long-term user memory: similarity recall into every turn + extraction after turns.
MEMORY_ENABLED=true
MEMORY_TOP_K=6
MEMORY_MAX_PER_USER=500
MEMORY_DEDUP_SIMILARITY=0.92

# ---- Workspaces / quotas ----
# Header that selects the active organization (absent = personal org).
ORG_HEADER=X-Org-Id
# Month-to-date usage cache for budget checks (seconds).
QUOTA_CACHE_SECONDS=30

# ---- Streaming / idempotency ----
# How long generation event logs stay replayable (resume after disconnect, background turns).
STREAM_EVENTS_TTL_SECONDS=3600
STREAM_EVENTS_MAXLEN=5000
# How long an Idempotency-Key maps to its original turn.
IDEMPOTENCY_TTL_SECONDS=86400

# ---- Rate limiting (per minute) ----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Storage ----
# local (files under UPLOAD_DIR, single host) | s3 (any S3-compatible bucket: AWS, MinIO, R2)
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Presigned attachment downloads (seconds; 0 = always proxy bytes through the API).
S3_PRESIGN_SECONDS=900
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.md,.markdown,.txt,.html,.htm,.csv,.json,.log

# ---- Attachments (images / files / audio on messages) ----
MAX_ATTACHMENT_MB=20
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif
# Text extracted from attached files (or transcribed audio) is given to the model inline.
ATTACHMENT_TEXT_MAX_CHARS=20000
# Used when the selected model cannot read images (empty = reject with 422).
VISION_FALLBACK_MODEL=

# ---- Voice ----
# auto = OpenAI when OPENAI_API_KEY is set, fake in AI_FAKE_MODE, otherwise disabled.
STT_PROVIDER=auto
STT_MODEL=whisper-1
TTS_PROVIDER=auto
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3
VOICE_PERSIST_REPLIES=true

# ---- Code execution tool (run_python) ----
# Subprocess with CPU/memory/file limits, approval required. Not a sandbox against a hostile
# model on a shared host: enable only in disposable containers.
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_TIMEOUT_SECONDS=30
CODE_EXECUTION_MEMORY_MB=512

# ---- Model Context Protocol (external tool servers) ----
MCP_ENABLED=true
# stdio servers run a command on the API host: server administrators only, when allowed.
MCP_ALLOW_STDIO=false
MCP_CALL_TIMEOUT_SECONDS=60
MCP_TOOLS_CACHE_SECONDS=300

# ---- Sharing / export ----
# Public base URL used in share links, e.g. https://chat.example.com
PUBLIC_BASE_URL=
SHARE_LINK_DEFAULT_HOURS=168

# ---- Push notifications ----
# none | webhook (signed POST to PUSH_WEBHOOK_URL; bridge to FCM / APNs / OneSignal)
PUSH_PROVIDER=none
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=

# ---- Background work ----
BACKGROUND_TASKS_INLINE=false

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO
METRICS_ENABLED=true
