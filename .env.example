# =========================================================
# NexusBot — Environment Configuration
# Copy to `.env` and fill in real values.
# =========================================================

# --- App ---
APP_NAME=NexusBot
APP_ENV=development              # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=*                # comma-separated, e.g. https://app.example.com,http://localhost:3000

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_HEADER=X-API-Key

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@postgres:5432/chatbot
SYNC_DATABASE_URL=postgresql+psycopg2://chatbot:chatbot@postgres:5432/chatbot

# --- Redis (cache + celery broker) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AI Providers ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- LangChain ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexusbot

# --- Vector store ---
VECTOR_BACKEND=pgvector          # pgvector | pinecone | weaviate
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENV=
WEAVIATE_URL=
WEAVIATE_API_KEY=

# --- RAG ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20

# --- Chat / Memory ---
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_SUMMARY_TRIGGER_TOKENS=3000
CHAT_RESPONSE_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.4

# --- Rate limit ---
RATE_LIMIT_PER_MINUTE=60

# --- Storage ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
