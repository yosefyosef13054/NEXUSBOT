          }
        },
        {
          "name": "List collections",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/collections"
          }
        },
        {
          "name": "Get collection",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/collections/{{collection_id}}"
          }
        },
        {
          "name": "Update collection",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
