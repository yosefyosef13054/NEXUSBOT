    {
      "name": "Memory",
      "item": [
        {
          "name": "List memories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/memories?page=1&page_size=50"
          }
        },
        {
          "name": "Add memory",
