            "url": "{{baseUrl}}/collections/{{collection_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Finance 2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete collection",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/collections/{{collection_id}}?delete_documents=false"
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
